# Template for Docker/.env, read by docker compose. Copy it and fill in the values:
#
#   cp Docker/.env.example Docker/.env
#
# Docker/.env is git-ignored and must never be committed.
#
# NEO4J_URI, NEO4J_USER, NEO4J_DATABASE and GRAPHIT_CORS_ORIGINS do not belong here:
# they describe the topology, not secrets, and are set in docker-compose.yml.

# --- Neo4j (container) ---------------------------------------------------------
# Freely chosen. Also used by the health check.
NEO4J_PASSWORD=

# --- LLM endpoint (OpenAI-compatible) ----------------------------------------
# Used for both the tutor chat and the question generator.
#
# For an OpenWebUI gateway the URL must end in "/api/v1" (e.g. https://<host>:<port>/api/v1);
# the OpenAI client appends "/chat/completions". Quick check: GET <LLM_BASE_URL>/models
# must return JSON, not HTML.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_STRUCTURED_METHOD=function_calling

# Optional CA certificate for an endpoint with a self-signed certificate. Put the file
# into Docker/certs/ and reference it by its path inside the container:
#   LLM_CA_BUNDLE=/etc/graphit/certs/ca.pem
LLM_CA_BUNDLE=

# --- OpenAI (optional) -------------------------------------------------------
# Only needed if LLM_BASE_URL is empty or SUPERVISOR_USE_OPENAI=true routes the chat to
# api.openai.com (model gpt-4o). The question generator always follows LLM_BASE_URL.
OPENAI_API_KEY=
SUPERVISOR_USE_OPENAI=false

# --- LangSmith (tracing, optional) -------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=GRAPHIT

# --- JupyterHub ----------------------------------------------------------------
# Comma-separated admin accounts. An admin approves newly registered students at
# http://localhost:8000/hub/authorize. Register this account first via /hub/signup.
JUPYTERHUB_ADMIN=admin

# Where the BROWSER reaches the backend.
GRAPHIT_BASE_URL=http://localhost:8077

# --- Extension behaviour ---------------------------------------------------------
# No secrets. Every value below is the schema default; empty lines behave the same.
# Invalid values are ignored. Takes effect with the next server start of a student
# (Hub Control Panel -> Stop/Start My Server).

# Diagnostics in the sidebar: backend address, "test connection" button and detailed
# error messages including CORS hints.
GRAPHIT_SHOW_DIAGNOSTICS=false

# Demo mode with built-in sample data instead of the backend. Development only.
GRAPHIT_MOCK_MODE=false

# Stream tutor answers token by token.
GRAPHIT_STREAMING=true

# Model name the chat reports to the backend.
GRAPHIT_CHAT_MODEL=graphit-tutor

# Number of due concepts preselected in the review tab.
GRAPHIT_REVIEW_SESSION_SIZE=5

# Keep the chat history across page reloads.
GRAPHIT_PERSIST_CHAT_HISTORY=false

# --- Automatic Neo4j dump on shutdown -------------------------------------------
# neo4j/entrypoint-dump.sh writes a dump to neo4j/dumps/auto/<timestamp>/neo4j.dump on
# every orderly stop and keeps the last GRAPHIT_DUMP_BEHALTEN dumps.
# GRAPHIT_DUMP_AUS=1 disables it.
GRAPHIT_DUMP_AUS=0
GRAPHIT_DUMP_BEHALTEN=3
