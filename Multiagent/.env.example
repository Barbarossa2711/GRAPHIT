# Template for Multiagent/.env, used when the backend or the scripts run locally
# (outside Docker). Copy it and fill in the values:
#
#   cp Multiagent/.env.example Multiagent/.env
#
# Multiagent/.env is git-ignored and must never be committed.

# --- LLM endpoint (OpenAI-compatible) ----------------------------------------
# All LLM calls (chat agents and question generator) go to this endpoint. If
# LLM_BASE_URL is empty, api.openai.com is used with OPENAI_API_KEY.
LLM_BASE_URL=

# Key for the endpoint above. Kept separate from OPENAI_API_KEY on purpose: it is only
# used while LLM_BASE_URL is set, so the OpenAI key is never sent to a foreign host.
LLM_API_KEY=

# Model name as listed by the endpoint (GET <LLM_BASE_URL>/models).
LLM_MODEL=

# Path to the CA certificate of an endpoint with a self-signed certificate (relative
# paths are resolved against the repository root). It becomes the only trust anchor,
# so the connection stays protected against man-in-the-middle attacks.
LLM_CA_BUNDLE=

# Emergency fallback: disables TLS verification entirely. Prefer LLM_CA_BUNDLE.
LLM_VERIFY_SSL=

# How structured output is enforced: function_calling | json_schema | json_mode.
# function_calling needs tool support by model and serving stack.
LLM_STRUCTURED_METHOD=function_calling

# --- OpenAI --------------------------------------------------------------------
# Used when LLM_BASE_URL is empty, by the slide annotation (build_chunks.py) and when
# SUPERVISOR_USE_OPENAI=true routes the chat to api.openai.com.
OPENAI_API_KEY=
SUPERVISOR_USE_OPENAI=false

# --- LangSmith (tracing, optional) -----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=GRAPHIT

# --- Neo4j ---------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Database inside the DBMS (not the user name).
NEO4J_DATABASE=neo4j

# --- Slides --------------------------------------------------------------------
# Slide content JSON (see README, "Data"). Default:
# Multiagent/BDT2026_data/BDT26-chunks-from-pdf.json
SLIDE_CONTENT_JSON=

# Version label of the slide set, shown below every chat answer.
FOLIEN_STAND=

# --- Chat streaming --------------------------------------------------------------
# true: compute the full answer first and stream it word by word (for latency
# comparisons). Default: real token streaming.
CHAT_STREAM_SIMULIERT=false
